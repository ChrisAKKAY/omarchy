# Loads table inet aaos before aaos-c2.service. systemd NFTSet only inserts
# the cgroup into the set; the table itself must already exist.
# Enable only via scripts/enable_aaos_host.sh on 4of9.

[Unit]
Description=AAOS C2 nftables egress table
Documentation=https://github.com/ChrisAKKAY/AkkayAgenticOS
Before=aaos-c2.service aaos-c2-dbus.service
After=network-pre.target
ConditionPathExists=/etc/nftables.d/aaos-c2.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env nft -f /etc/nftables.d/aaos-c2.nft
ExecStop=/usr/bin/env nft destroy table inet aaos
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=
NoNewPrivileges=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=aaos-c2.service
